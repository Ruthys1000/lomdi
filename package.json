{
  "name": "lomdi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "מחולל לומדות HTML מודרני מבוסס בלוקים",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run build:assets",
    "dev": "vite",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:runtime": "vite build --config vite.runtime.config.ts",
    "build:assets": "npm run build:fonts && npm run build:runtime",
    "build:app": "tsc -b && vite build",
    "build": "npm run build:assets && npm run build:app",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "pretest": "npm run build:assets",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/assistant": "^5.3.0",
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "nanoid": "^5.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zundo": "^2.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
