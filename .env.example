# מפתחות לפיתוח מקומי: העתיקו ל-.env (לא נשמר בגיט) והריצו `vercel dev`.
# בפרודקשן: נקבעים ב-Vercel → Project → Settings → Environment Variables.

# יצירת לומדה מטקסט (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# צילומי סטוק ללומדות (Pexels — מפתח חינמי מ-https://www.pexels.com/api/)
# ב-Vercel: אחרי הגדרת המשתנה צריך redeploy, והוא חייב להיות מסומן ל-Production.
PEXELS_API_KEY=

# איורים שנוצרים ב-AI ללומדות. משמש את /api/generate-image כשמקור התמונות
# בטופס היצירה הוא "איורים ב-AI". שני ספקים נתמכים:
#
# בחירת הספק: IMAGE_PROVIDER=gemini|recraft דורס במפורש; אם לא הוגדר, נבחר
# Gemini אוטומטית כשמוגדר GEMINI_API_KEY, אחרת Recraft.
IMAGE_PROVIDER=

# Gemini (Google AI Studio — https://aistudio.google.com/apikey). ב-Vercel:
# אחרי הגדרת המשתנה צריך redeploy, והוא חייב להיות מסומן ל-Production.
GEMINI_API_KEY=
# אופציונלי — לשדרוג מודל התמונות בלי שינוי קוד (ברירת מחדל: gemini-2.5-flash-image).
GEMINI_IMAGE_MODEL=

# Recraft (https://www.recraft.ai/docs) — ספק חלופי.
RECRAFT_API_KEY=
